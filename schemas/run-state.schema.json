{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-sdd.dev/schemas/run-state.schema.json",
  "title": "RunState",
  "description": "Persisted orchestrator state for solidsdd-run / solidsdd-loop resume, retry budgets, and per-item progress under .solidsdd/changes/<change_id>/run-state.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "change_id", "phase", "run_retry"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "change_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 48
    },
    "phase": {
      "type": "string",
      "enum": [
        "context",
        "intake",
        "critique_change_context",
        "brief",
        "critique_change_brief",
        "decompose",
        "critique_work_plan",
        "waves",
        "integration_verify",
        "critique_integration",
        "done",
        "stopped"
      ],
      "description": "Highest-level solidsdd-run phase last completed or currently in progress."
    },
    "wave_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based index of the current or last wave when phase is waves."
    },
    "run_retry": {
      "$ref": "#/$defs/retry_budget"
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/item_state"
      },
      "description": "Map of WorkPlan item id → slice progress."
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verification_report": {
          "type": "string",
          "description": "Path relative to change dir, e.g. integration-verification-report.json"
        },
        "critique_report": {
          "type": "string"
        },
        "last_loop_action": {
          "type": "string",
          "enum": ["retry", "human_gate", "stop"]
        }
      }
    },
    "isolation_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Checklist / violation notes that must survive resume."
    },
    "stopped_reason": {
      "type": "string",
      "description": "Why phase is stopped (gate, budget exhausted, etc.)."
    },
    "updated_at": {
      "type": "string",
      "description": "ISO-8601 timestamp of last write (optional)."
    }
  },
  "$defs": {
    "retry_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remaining", "max"],
      "properties": {
        "remaining": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "const": 3,
          "description": "Default max_auto_retries = 3."
        },
        "last_suggested_skills": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "item_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "ready", "running", "done", "blocked"]
        },
        "loop_phase": {
          "type": "string",
          "enum": [
            "context",
            "judge",
            "critique_application_plan",
            "apply",
            "derive_tests",
            "implement",
            "verify",
            "done",
            "stopped"
          ]
        },
        "loop_retry": {
          "$ref": "#/$defs/retry_budget"
        },
        "blocked_reason": { "type": "string" },
        "last_loop_action": {
          "type": "string",
          "enum": ["retry", "human_gate", "stop"]
        },
        "artifact_dir": {
          "type": "string",
          "description": "Relative to change dir; default items/<item_id>"
        }
      }
    }
  }
}
