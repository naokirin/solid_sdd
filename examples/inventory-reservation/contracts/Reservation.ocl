-- Reservation domain contracts for inventory-reservation (solid_sdd evaluation sample)
-- Source of truth for DbC; tests under tests/contracts are derived from this.
-- W1: authorized reserve soft-hold (PrincipalAuthorized, QuantityPositive,
--     SufficientAvailableStock, HoldCreatedWithTtl, AvailableStockReduced).
-- W2: insufficient-stock reserve failure is first-class — named
--     InsufficientStockError; no Hold created; available stock unchanged.
-- W3: unauthorized reserve or release fails with named UnauthorizedError;
--     no Hold created by the failed attempt; available stock and existing
--     holds unchanged.
-- W4: authorized release restores held quantity to available stock and
--     removes the hold (HoldExists, AvailableStockRestored, HoldRemoved).
-- W5: service-side expire past TTL restores held quantity and removes the
--     hold (HoldExists, HoldPastTtl, AvailableStockRestoredOnExpiry,
--     HoldRemoved); PreconditionError when hold missing or not past TTL.
-- add-reservation-lookup W1: authorized get-by-id lookup of an existing
--     visible soft-hold (PrincipalAuthorized, HoldExists, ResultIsHoldDetails,
--     AvailableStockUnchanged, HoldsUnchanged); no mutation.
-- add-reservation-lookup W2: named missing/not-visible (PreconditionError)
--     and unauthorized (UnauthorizedError) lookup failures; stock and holds
--     unchanged. Missing and not-visible share one PreconditionError channel.
-- add-lookup-available-stock W2: authorized lookup success includes current
--     availableStock for the hold's SKU (self.availableStock(hold.sku), not a
--     reserve-time snapshot); retain ResultIsHoldDetails hold fields and
--     AvailableStockUnchanged / HoldsUnchanged; UnauthorizedError /
--     PreconditionError failure posts unchanged (no mutation).
-- add-concurrent-last-unit-safety W1: InsufficientStockError is the shared
--     named channel for sequential insufficient stock and concurrent race
--     losers on contract-testable paths; AvailableStockNonNegative is a
--     checkable module invariant (sequential posts reinforce the operated
--     SKU). UnauthorizedErrorOnReserve posts unchanged.
-- add-concurrent-last-unit-safety W2 (thin SoT bridge): no new pre/post/inv.
--     W2 Vitest/impl sequential stand-ins reuse W1 reserve posts —
--     PrincipalAuthorized / UnauthorizedErrorOnReserve (+ no-mutation),
--     InsufficientStockError / NoHoldCreatedOnInsufficientStock /
--     AvailableStockUnchangedOnInsufficientStock, AvailableStockNonNegative
--     and AvailableStockNonNegativeAfterReserve. True concurrent last-unit
--     exclusivity and interleaving never-negative stock are formal-owned
--     (TLA+/TLC); do not encode interleaving in OCL.
-- add-list-holds W1: authorized full-dump list of currently visible
--     soft-holds (same visibility universe as get-by-id / self.holds());
--     LookupResponse-equivalent items including availableStock; empty
--     collection when none visible; no mutation. Unauthorized → named
--     UnauthorizedError; stock and holds unchanged (POL-OPAQUE-PRINCIPAL-AUTHZ).
-- add-list-sort-expires W1: authorized list success dump ordered by
--     expiresAt ascending (non-decreasing); equal expiresAt may use any
--     stable order (no secondary key). AuthZ / UnauthorizedError /
--     full-dump / no-mutation posts retained unchanged.
-- Named error vocabulary shared with OpenAPI.

-- Default TTL when caller omits ttlSeconds (seconds).
-- Sample convention: DEFAULT_TTL_SECONDS = 300

-- Non-negative available stock for every tracked SKU (W1 foundation;
-- W2 sequential/contract-testable SoT bridge — no additive inv).
-- Concurrent interleaving exclusivity is formal-owned (W2 formal/).
context Reservation
inv AvailableStockNonNegative:
  self.holds()->collect(h | h.sku)->asSet()->forAll(s |
    self.availableStock(s) >= 0)

context Reservation::reserve(principal: String, sku: String, quantity: Integer, ttlSeconds: Integer): Hold
pre PrincipalAuthorized: principal.isAuthorized()
pre QuantityPositive: quantity > 0
pre SufficientAvailableStock: self.availableStock(sku) >= quantity
post HoldCreatedWithTtl: result.oclIsNew() and result.sku = sku and result.quantity = quantity
  and result.expiresAt = self.now() + ttlSeconds
post AvailableStockReduced: self.availableStock(sku) = self.availableStock(sku)@pre - quantity
-- SufficientAvailableStock violation (sequential insufficient stock OR
-- concurrent race loser observing availableStock@pre < quantity) → named
-- domain error InsufficientStockError (same channel; not a language
-- builtin / not a concurrent-only error type); no extra soft-hold for the
-- failing attempt; available stock unchanged by that attempt.
-- W2 reuses these posts as the sequential/Vitest SoT stand-in (no new OCL).
post InsufficientStockError:
  (self.availableStock(sku)@pre < quantity) implies result.oclIsInvalid()
post NoHoldCreatedOnInsufficientStock:
  (self.availableStock(sku)@pre < quantity) implies self.holds() = self.holds()@pre
post AvailableStockUnchangedOnInsufficientStock:
  (self.availableStock(sku)@pre < quantity) implies
    self.availableStock(sku) = self.availableStock(sku)@pre
-- Sequential/contract-testable reinforcement of AvailableStockNonNegative
-- for the operated SKU (success and insufficient-stock / race-loser paths).
-- W2 SoT bridge: same post; interleaving never-negative is formal-owned.
post AvailableStockNonNegativeAfterReserve:
  self.availableStock(sku) >= 0
-- W3: PrincipalAuthorized violation → named domain error UnauthorizedError
--     (not a language builtin); no soft-hold; stock and holds unchanged.
-- W2 SoT bridge: AuthZ unchanged — opaque-principal UnauthorizedError posts.
post UnauthorizedErrorOnReserve:
  (not principal.isAuthorized()) implies result.oclIsInvalid()
post NoHoldCreatedOnUnauthorizedReserve:
  (not principal.isAuthorized()) implies self.holds() = self.holds()@pre
post AvailableStockUnchangedOnUnauthorizedReserve:
  (not principal.isAuthorized()) implies
    self.availableStock(sku) = self.availableStock(sku)@pre

context Reservation::release(principal: String, holdId: String): Void
pre PrincipalAuthorized: principal.isAuthorized()
pre HoldExists: self.hold(holdId)->notEmpty()
-- W3: PrincipalAuthorized violation → named UnauthorizedError; stock and holds unchanged.
post UnauthorizedErrorOnRelease:
  (not principal.isAuthorized()) implies self.holds() = self.holds()@pre
post HoldsUnchangedOnUnauthorizedRelease:
  (not principal.isAuthorized()) implies self.holds() = self.holds()@pre
post AvailableStockUnchangedOnUnauthorizedRelease:
  (not principal.isAuthorized()) implies
    self.hold(holdId)->notEmpty() implies
      self.availableStock(self.hold(holdId).sku) =
        self.availableStock(self.hold(holdId).sku)@pre
-- W4: HoldExists violation → named domain error PreconditionError
--     (not a language builtin); authorized success restores stock and removes hold.
post AvailableStockRestored:
  self.availableStock(self.hold(holdId)@pre.sku) =
    self.availableStock(self.hold(holdId)@pre.sku)@pre + self.hold(holdId)@pre.quantity
post HoldRemoved: self.hold(holdId)->isEmpty()

-- W5: treat soft-hold past TTL as expired; restore stock and remove hold.
-- Checkability: self.now() is the service clock (injectable in tests).
-- Prefer a hold whose expiresAt is already strictly before self.now()
-- so HoldPastTtl is exercisable without wall-clock waits.
context Reservation::expire(holdId: String): Void
pre HoldExists: self.hold(holdId)->notEmpty()
pre HoldPastTtl: self.hold(holdId).expiresAt < self.now()
-- HoldExists / HoldPastTtl violation → named domain error PreconditionError
--     (not a language builtin); stock and holds unchanged.
-- Aligns with OpenAPI expire 400: HoldMissing / HoldNotPastTtl.
post PreconditionErrorOnExpireHoldMissing:
  (self.hold(holdId)@pre->isEmpty()) implies self.holds() = self.holds()@pre
post PreconditionErrorOnExpireHoldNotPastTtl:
  (self.hold(holdId)@pre->notEmpty() and
    not (self.hold(holdId)@pre.expiresAt < self.now())) implies
      self.holds() = self.holds()@pre
post AvailableStockUnchangedOnExpireHoldNotPastTtl:
  (self.hold(holdId)@pre->notEmpty() and
    not (self.hold(holdId)@pre.expiresAt < self.now())) implies
      self.availableStock(self.hold(holdId)@pre.sku) =
        self.availableStock(self.hold(holdId)@pre.sku)@pre
post AvailableStockRestoredOnExpiry:
  self.availableStock(self.hold(holdId)@pre.sku) =
    self.availableStock(self.hold(holdId)@pre.sku)@pre + self.hold(holdId)@pre.quantity
post HoldRemoved: self.hold(holdId)->isEmpty()

-- add-reservation-lookup W1: authorized get-by-id of an existing visible
-- soft-hold; return that hold's details; stock and holds unchanged.
-- Sample visibility: a hold present in self.holds() is visible; whether
-- expired holds are not-visible vs a distinct failure is deferred (Brief
-- open_questions) and shares the W2 missing/not-visible named error.
-- add-lookup-available-stock W2: authorized success also returns current
-- availableStock for the hold's SKU (= self.availableStock(hold.sku) now;
-- not the value observed at reserve time). Failure posts unchanged.
context Reservation::lookup(principal: String, holdId: String): Hold
pre PrincipalAuthorized: principal.isAuthorized()
pre HoldExists: self.hold(holdId)->notEmpty()
post ResultIsHoldDetails:
  result.sku = self.hold(holdId)@pre.sku and
  result.quantity = self.hold(holdId)@pre.quantity and
  result.expiresAt = self.hold(holdId)@pre.expiresAt and
  result.availableStock = self.availableStock(self.hold(holdId)@pre.sku)
post AvailableStockUnchanged:
  self.availableStock(self.hold(holdId)@pre.sku) =
    self.availableStock(self.hold(holdId)@pre.sku)@pre
post HoldsUnchanged: self.holds() = self.holds()@pre
-- W2: HoldExists / not-visible violation → named domain error
--     PreconditionError (shared missing/not-visible channel; same vocabulary
--     as release/expire HoldExists failures and OpenAPI getReservation 400);
--     holds unchanged (stock unchanged implied — no sku when hold absent).
post HoldMissingOrNotVisibleErrorOnLookup:
  (self.hold(holdId)@pre->isEmpty()) implies result.oclIsInvalid()
post HoldsUnchangedOnHoldMissingLookup:
  (self.hold(holdId)@pre->isEmpty()) implies self.holds() = self.holds()@pre
-- W2: PrincipalAuthorized violation → named UnauthorizedError; stock and
--     holds unchanged (aligns with implement UnauthorizedError).
post UnauthorizedErrorOnLookup:
  (not principal.isAuthorized()) implies result.oclIsInvalid()
post HoldsUnchangedOnUnauthorizedLookup:
  (not principal.isAuthorized()) implies self.holds() = self.holds()@pre
post AvailableStockUnchangedOnUnauthorizedLookup:
  (not principal.isAuthorized() and self.hold(holdId)@pre->notEmpty()) implies
    self.availableStock(self.hold(holdId)@pre.sku) =
      self.availableStock(self.hold(holdId)@pre.sku)@pre

-- add-list-holds W1: authorized full-dump list of currently visible
-- soft-holds (same visibility as get-by-id: a hold in self.holds() is
-- visible); one dump with no filter dimensions; each item
-- LookupResponse-equivalent (sku, quantity, expiresAt, availableStock
-- = self.availableStock(item.sku) now); empty when none visible;
-- stock and holds unchanged. No paging / sku/status/time filters in OCL.
-- PrincipalAuthorized violation → named UnauthorizedError; no mutation
-- (aligns with lookup/reserve/release UnauthorizedError posts).
-- add-list-sort-expires W1: success result ordered by expiresAt
-- ascending (non-decreasing adjacent pairs); equal expiresAt may use
-- any stable order (no secondary key required). Size 0/1 vacuously
-- ordered. AuthZ and UnauthorizedError posts unchanged.
context Reservation::list(principal: String): Sequence(Hold)
pre PrincipalAuthorized: principal.isAuthorized()
post ResultIsFullDumpOfVisibleHolds:
  result->size() = self.holds()@pre->size() and
  self.holds()@pre->forAll(h |
    result->exists(r |
      r.sku = h.sku and
      r.quantity = h.quantity and
      r.expiresAt = h.expiresAt and
      r.availableStock = self.availableStock(h.sku)))
post ResultOrderedByExpiresAtAscending:
  Sequence{1..result->size()-1}->forAll(i |
    result->at(i).expiresAt <= result->at(i + 1).expiresAt)
post EmptyCollectionWhenNoneVisible:
  self.holds()@pre->isEmpty() implies result->isEmpty()
post HoldsUnchanged: self.holds() = self.holds()@pre
post AvailableStockUnchanged:
  self.holds()@pre->collect(h | h.sku)->asSet()->forAll(s |
    self.availableStock(s) = self.availableStock(s)@pre)
post UnauthorizedErrorOnList:
  (not principal.isAuthorized()) implies result.oclIsInvalid()
post HoldsUnchangedOnUnauthorizedList:
  (not principal.isAuthorized()) implies self.holds() = self.holds()@pre
post AvailableStockUnchangedOnUnauthorizedList:
  (not principal.isAuthorized()) implies
    self.holds()@pre->collect(h | h.sku)->asSet()->forAll(s |
      self.availableStock(s) = self.availableStock(s)@pre)
