-- Calculator domain contracts for arithmetic-api (solid_sdd evaluation sample)
-- Source of truth for DbC; tests under tests/contracts are derived from this.

context Calculator::add(a: Real, b: Real): Real
post ResultIsSum: result = a + b

context Calculator::sub(a: Real, b: Real): Real
post ResultIsDifference: result = a - b

context Calculator::mul(a: Real, b: Real): Real
post ResultIsProduct: result = a * b

context Calculator::div(a: Real, b: Real): Real
pre DivisorIsNonZero: b <> 0
post ResultIsQuotient: result = a / b

-- JavaScript `%` remainder: sign follows dividend (a - b * truncTowardZero(a / b))
context Calculator::mod(a: Real, b: Real): Real
pre DivisorIsNonZero: b <> 0
post ResultIsRemainder: result = a - b * (a / b).truncatedTowardZero()

-- JavaScript `**` exponentiation (IEEE-754 double semantics).
-- Deliberately no `pre` clause: unlike div/mod, pow does not reject any (a, b)
-- pair with a zero-divisor-style PreconditionError (ChangeBrief X4 / Change
-- Context NFR1 & §6). Any a, b accepted by the request shape is valid input.
context Calculator::pow(a: Real, b: Real): Real
post ResultIsPower: result = a ** b

-- Arithmetic mean of the two operands.
-- Deliberately no `pre` clause: like pow, avg has no mathematically
-- undefined/invalid input region, so it must not inherit the div/mod
-- zero-divisor-style PreconditionError pattern by analogy (ChangeBrief X4,
-- PAT-OPERATION-PRECONDITION-SCOPE). Any a, b accepted by the request shape
-- is valid input.
context Calculator::avg(a: Real, b: Real): Real
post ResultIsMean: result = (a + b) / 2
