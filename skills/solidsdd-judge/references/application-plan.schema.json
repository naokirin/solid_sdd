{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-sdd.dev/schemas/application-plan.schema.json",
  "title": "ApplicationPlan",
  "description": "Output of solidsdd.judge: where and how to apply machine-checkable specs (Phase 2 fields optional).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "change_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 48,
      "description": "Optional but recommended: active change_id this plan belongs to."
    },
    "summary": {
      "type": "string",
      "description": "Short human-readable summary of the plan."
    },
    "human_gate": {
      "$ref": "#/$defs/human_gate"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "location",
        "density",
        "rationale",
        "adapter_hint",
        "status"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["api", "dbc", "formal", "natural_only"]
        },
        "location": {
          "type": "string",
          "description": "Boundary or module identifier (path, operationId, type name, etc.)."
        },
        "density": {
          "type": "string",
          "enum": ["thin", "standard", "strict"]
        },
        "rationale": {
          "type": "string",
          "description": "Why this kind/density/status was chosen, referencing judgment axes."
        },
        "adapter_hint": {
          "type": "string",
          "description": "Concrete adapter hint, e.g. openapi, graphql, ocl, defer-formal."
        },
        "status": {
          "type": "string",
          "enum": ["apply", "defer", "skip"]
        },
        "covers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "WorkPlan item ids (e.g. W1) this target serves. Prefer when the plan is for one slice."
        },
        "signals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Judgment axis signal ids (e.g. http_boundary, breaking_change)."
        },
        "breaking": {
          "type": "boolean",
          "description": "True when this target involves a breaking contract change."
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "human_gate": {
          "$ref": "#/$defs/human_gate"
        }
      }
    }
  }
}
