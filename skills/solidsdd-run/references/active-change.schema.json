{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-sdd.dev/schemas/active-change.schema.json",
  "title": "ActiveChange",
  "description": "Pointer to the active change under .solidsdd/changes/<change_id>/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "change_id"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "change_id": {
      "$ref": "#/$defs/change_id"
    }
  },
  "$defs": {
    "change_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 48,
      "description": "Meaningful kebab-case id; must match the directory name under changes/."
    }
  }
}
